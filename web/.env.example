# Public browser configuration. Copy to .env.local for local development.
# Use the values from your Firebase project's web app settings.
NEXT_PUBLIC_API_BASE=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Same value as the backend's STOREFRONT_BASE_DOMAIN. Enables subdomain stores.
NEXT_PUBLIC_STOREFRONT_BASE_DOMAIN=
# Hostnames of the platform itself (comma-separated). Any other host reaching
# the app is looked up as a reseller's custom domain.
NEXT_PUBLIC_PLATFORM_HOSTS=buy.nityhub.online,localhost
# Web Push key pair from Firebase Console -> Project settings -> Cloud
# Messaging -> Web Push certificates. Leave blank to hide the push opt-in.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
