# ---------------------------------------------------------------------------
# NityHub API server environment
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=production
PORT=3000

# Public URLs (used for CORS, Paystack callbacks, provider webhooks)
APP_URL=https://nityhub.onrender.com
FRONTEND_URL=https://buy.nityhub.online
BASE_URL=
# Extra browser origins allowed by CORS (comma-separated). Add your Next.js
# frontend's deployed origin here in production.
ADDITIONAL_ALLOWED_ORIGINS=

# --- Firebase Admin credentials (provide ONE of these) ---------------------
# Preferred for hosting: the full service-account JSON as a single value, or
# base64-encoded. Avoid shipping serviceAccountKey.json in the repo/image.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Or a path to a mounted key file (kept outside version control):
FIREBASE_SERVICE_ACCOUNT_PATH=
# Realtime Database URL (or include databaseURL in the service account):
FIREBASE_DATABASE_URL=

# --- Payments (Paystack) — REQUIRED ----------------------------------------
PAYSTACK_SECRET_KEY=

# --- Data providers --------------------------------------------------------
HUBNET_API_KEY=
# Where Hubnet posts status callbacks. Leave blank to derive it from BASE_URL.
# Must be THIS server's public URL — the token and provider query parameters are
# appended automatically.
HUBNET_WEBHOOK_URL=
# Leave blank to use Hubnet's universal status endpoint (recommended). Setting
# this to your own app URL disables nothing any more, but it is still wrong —
# the server logs a warning and falls back to Hubnet's endpoint.
HUBNET_STATUS_URL=
# Hubnet allows 5 requests/minute per endpoint. These pace the status poller so
# reconciliation does not burn its budget on 1007 rate-limit errors.
HUBNET_STATUS_POLL_MIN_INTERVAL_MS=12000
HUBNET_STATUS_POLL_MAX_PER_RUN=4

GODSWAY_API_KEY=
GODSWAY_BASE_URL=https://console.ckgodsway.com/api
# Leave blank to use <GODSWAY_BASE_URL>/order-status.
GODSWAY_STATUS_URL=
# Signing secret from CK-Godsway's API Keys page. CK signs every webhook with a
# hex HMAC-SHA256 of the raw body (X-Webhook-Signature). This is CK's secret,
# NOT the same value as PROVIDER_WEBHOOK_SECRET above - do not reuse that one.
# Register https://<APP_URL>/webhook/godsway as the endpoint on that same page.
# Without this, /webhook/godsway rejects every delivery in production and CK
# auto-disables the endpoint after 10 consecutive failures.
GODSWAY_WEBHOOK_SECRET=
# The network code CK-Godsway expects as `networkKey` on /data-purchase.
# AirtelTigo is blank because CK's code for it is not documented anywhere we can
# read - and a guess would pass validation here only to fail after a customer
# has been charged. Until it is set, routing AT to CK-Godsway is refused with
# "has no networkKey set for godsway". Can also be set per package under
# Catalog -> Packages -> Mapping.
GODSWAY_AT_NETWORK_KEY=
GODSWAY_MTN_NETWORK_KEY=YELLO
GODSWAY_TELECEL_NETWORK_KEY=TELECEL

GIGSHUB_API_KEY=
GIGSHUB_BASE_URL=https://gigshub.store/api/v1

# PBM HUB Developer Platform. The key is shown once at creation on the dashboard
# API page (format qn_XXXX_XXXX...), expires after a year, and spends the PBM HUB
# wallet directly - keep it server-side only. Endpoints are under <base>/api/v1.
# This file is COMMITTED - placeholders only, never a real key. The live value
# belongs in .env (gitignored) and in the host's environment settings.
PBMHUB_API_KEY=
PBMHUB_BASE_URL=https://developer.pbmhub.pro
# The network ids PBM HUB expects as `network` on /purchase. All three are
# documented, so unlike the CK-Godsway keys above these defaults are real values
# rather than placeholders - override only if GET /api/v1/networks disagrees for
# your account. Can also be set per package under Catalog -> Packages -> Mapping.
PBMHUB_MTN_NETWORK_ID=mtnup2u
PBMHUB_AT_NETWORK_ID=airteltigo
PBMHUB_TELECEL_NETWORK_ID=telecel

# --- Provider webhook hardening --------------------------------------------
# REQUIRED in production. Shared secret checked (timing-safe) on inbound
# provider webhooks. Without it the server rejects every callback when
# NODE_ENV=production, because an open /webhook lets anyone mark any order
# delivered. The value is appended to the provider webhook URLs automatically,
# so setting it here is all that is needed.
PROVIDER_WEBHOOK_SECRET=
# Optional IP allowlist for provider webhooks (comma-separated).
PROVIDER_WEBHOOK_ALLOWED_IPS=
